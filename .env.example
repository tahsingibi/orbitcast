# Bu dosyayı .env.local olarak kopyalayın ya da `npm run setup` çalıştırın.
# Gerçek anahtarları buraya değil, .env.local içine yazın — o dosya
# .gitignore'da, bu dosya repoda.

# --- Yayın kaynağı -------------------------------------------------------------
# Parça listesinin nereden okunacağı: youtube | redis | file
# Boş bırakılırsa aşağıdaki değişkenlere bakılarak otomatik seçilir.
RADIO_SOURCE=

# youtube modunda zorunlu. Listeyi YouTube'da düzenlersiniz, yayın kendiliğinden
# uyar; hiçbir panele veya depoya ihtiyaç kalmaz.
YOUTUBE_PLAYLIST_URL=

# youtube modunda listenin ne sıklıkta tazeleneceği (saniye, varsayılan 300).
RADIO_PLAYLIST_TTL_SEC=

# redis modunda zorunlu. Şarkı eklemek için deploy almak gerekmez.
# Vercel'de: Storage sekmesi -> Upstash Redis -> bu iki değişken otomatik gelir.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Yayın yönetimi (/admin) ---------------------------------------------------
# Tanımlanmazsa admin paneli tamamen kapalı kalır.
ADMIN_PASSWORD=

# --- YouTube metadata ----------------------------------------------------------
# Opsiyonel ama üretimde ÖNERİLİR. Tanımlıysa süre/başlık bilgisi resmî
# YouTube Data API v3 ile çekilir (kota: 10.000 birim/gün).
# Tanımlı değilse anahtarsız yönteme düşülür: liste sayfası tek istekte
# okunur ama ilk ~100 parçayla sınırlıdır ve sunucu IP'leri bot kontrolüne
# takılabilir.
# Anahtar: https://console.cloud.google.com -> YouTube Data API v3 -> Credentials
YOUTUBE_API_KEY=

# --- Paylaşım bağlantıları -----------------------------------------------------
# X paylaşımlarındaki OpenGraph kartı için mutlak adres. Vercel'de otomatik
# algılanır; kendi alan adınız varsa buraya yazın (ör. https://radyom.com).
NEXT_PUBLIC_SITE_URL=

# --- Geliştirme: başka cihazdan erişim -----------------------------------------
# Telefondan LAN IP'si ile test edeceksen adresi buraya ekle (virgülle çoğalt).
# `.local` adresleri zaten izinli; bu satır sadece IP gibi adresler için gerekir.
# Yalnızca `next dev` içindir, üretimi etkilemez.
ALLOWED_DEV_ORIGINS=
